<h1>Edit Miter Frame</h1>

<%= form_with(model: @miter_frame, local: true) do |form| %>
  <div class="yield-bubble">
    <div class="cut-name">
      <strong>
        <%= form.label :name, "Name" %><br>
        <%= form.text_field :name, class: "form-input" %>
      </strong>
    </div>

    <div class="cut-specs-text">
      <p>
        <%= form.label :shape_type, "Shape" %><br>
        <%= form.text_field :shape_type, class: "form-input" %>
      </p>

      <p>
        <%= form.label :inside_length_display, "Inside Length (in)" %><br>
        <%= form.text_field :inside_length_display, class: "form-input" %>
      </p>

      <p>
        <%= form.label :outside_length_show, "Outside Length (in)" %><br>
        <%= form.text_field :outside_length_show, class: "form-input" %>
      </p>

      <p>
        <%= form.label :board_width_display, "Board Width (in)" %><br>
        <%= form.text_field :board_width_display, class: "form-input" %>
      </p>

      <p>
        <%= form.label :miter_angle, "Miter Angle (°)" %><br>
        <%= form.number_field :miter_angle, step: :any, class: "form-input" %>
      </p>
    </div>

    <div class="bubble-actions">
      <%= form.submit "Save Changes", class: "edit-text" %>
      <%= link_to "Cancel", miter_frames_path, class: "delete-text" %>
    </div>
  </div>
<% end %>
